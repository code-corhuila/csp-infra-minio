# Names and placeholders only (Annex J.5.1). Copy to env/dev.env, which is git-ignored, and fill it in.
# Development: values may be local and throwaway.
COMPOSE_PROJECT_NAME=csp-dev
# Host port of the console; it is published to 127.0.0.1 only, and only in dev.
RUSTFS_CONSOLE_PORT=9001

# Root account: operation and the setup job only; no service uses it. The secrets: openssl rand -hex 24
RUSTFS_ROOT_USER=
RUSTFS_ROOT_PASSWORD=
# Bucket of the ticket PDFs and its hard quota (a write over it is refused).
TICKETS_BUCKET=tickets
TICKETS_BUCKET_QUOTA=1G
# ticketing_pdf_writer: put and get on tickets/* (csp-worker). ticketing_pdf_reader: get on tickets/* (csp-ticketing-api).
TICKETING_PDF_WRITER_SECRET=
TICKETING_PDF_READER_SECRET=

# What csp-ticketing-api reads. The storage is reached by its service name on the platform network, never by localhost.
OBJECT_STORAGE_URL=http://rustfs:9000
OBJECT_STORAGE_BUCKET=tickets
OBJECT_STORAGE_ACCESS_KEY=ticketing_pdf_reader
OBJECT_STORAGE_SECRET_KEY=${TICKETING_PDF_READER_SECRET}
